# Copie para backend/.env e preencha. Nunca commite o .env.
# Strings de conexão: painel do Supabase > Connect
# Transaction pooler (porta 6543) — usado pela aplicação
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler ou conexão direta (porta 5432) — usado pelas migrations
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
# Gere com: openssl rand -hex 32
JWT_SECRET=""
FRONTEND_URL="http://localhost:4200"
APP_TIMEZONE="America/Cuiaba"
